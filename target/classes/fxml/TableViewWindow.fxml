<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="myapp.controllers.TableViewController"
            prefWidth="800.0" prefHeight="450.0">

    <children>
        <!-- Панель кнопок управления (как в методичке) -->
        <HBox AnchorPane.topAnchor="10.0"
              AnchorPane.leftAnchor="10.0"
              spacing="10.0">
            <children>
                <Button text="Добавить" onAction="#handleNewBuyer" prefWidth="100.0"/>
                <Button text="Изменить" onAction="#handleEditBuyer" prefWidth="100.0"/>
                <Button text="Удалить" onAction="#handleDeleteBuyer" prefWidth="100.0"/>
            </children>
        </HBox>

        <!-- Таблица данных -->
        <TableView fx:id="tableView"
                   AnchorPane.topAnchor="50.0"
                   AnchorPane.bottomAnchor="10.0"
                   AnchorPane.leftAnchor="10.0"
                   AnchorPane.rightAnchor="10.0">
            <columns>
                <TableColumn fx:id="col1" prefWidth="150.0" text="Column 1" />
                <TableColumn fx:id="col2" prefWidth="250.0" text="Column 2" />
                <TableColumn fx:id="col3" prefWidth="200.0" text="Column 3" />
                <TableColumn fx:id="col4" prefWidth="150.0" text="Column 4" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
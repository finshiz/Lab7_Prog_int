<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="myapp.controllers.SalesBookViewController"
            prefWidth="800.0" prefHeight="400.0">
    <children>
        <!-- Кнопки управления -->
        <HBox AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" spacing="10.0">
            <Button text="Добавить" onAction="#handleNewInvoice" prefWidth="100.0"/>
            <Button text="Изменить" onAction="#handleEditInvoice" prefWidth="100.0"/>
            <Button text="Удалить" onAction="#handleDeleteInvoice" prefWidth="100.0"/>
        </HBox>

        <!-- Таблица накладных -->
        <TableView fx:id="invoiceTable" AnchorPane.topAnchor="50.0" AnchorPane.bottomAnchor="10.0"
                   AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="№ Накладной"/>
                <TableColumn fx:id="colDate" prefWidth="120.0" text="Дата"/>
                <TableColumn fx:id="colBuyer" prefWidth="250.0" text="Покупатель"/>
                <TableColumn fx:id="colTotal" prefWidth="120.0" text="Сумма"/>
                <TableColumn fx:id="colPay" prefWidth="120.0" text="Оплата"/>
            </columns>
        </TableView>
    </children>
</AnchorPane>